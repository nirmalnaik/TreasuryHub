logging {
  level = "info"
}

otelcol.receiver.otlp "treasuryhub" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }

  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    traces = [otelcol.processor.batch.traces.input]
  }
}

otelcol.processor.batch "traces" {
  output {
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"

    tls {
      insecure = true
    }
  }
}

local.file_match "treasuryhub_logs" {
  path_targets = [
    {"__path__" = "/var/log/treasuryhub/customer-service.json", "service_name" = "customer-service", "environment" = "local"},
    {"__path__" = "/var/log/treasuryhub/account-service.json", "service_name" = "account-service", "environment" = "local"},
    {"__path__" = "/var/log/treasuryhub/payment-service.json", "service_name" = "payment-service", "environment" = "local"},
  ]
}

loki.source.file "treasuryhub_logs" {
  targets       = local.file_match.treasuryhub_logs.targets
  forward_to    = [loki.write.local.receiver]
  tail_from_end = false
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
